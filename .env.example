# ===== OpenRouter =====
# کلید را از https://openrouter.ai/keys بگیرید
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# مدل اصلی. قبل از اولین اجرا با این دستور اسم دقیق مدل‌ها را ببینید:
#   python -m scripts.check_openrouter --search deepseek
LLM_MODEL=~deepseek/deepseek-pro-latest

# اختیاری: برای مدل‌های reasoning (low / medium / high). خالی = پیش‌فرض مدل
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.7
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SEC=120

# ===== دیتابیس =====
# داخل docker compose همین مقدار درست است.
# برای اجرای بدون داکر می‌توانید بگذارید: sqlite:///./content_engine.db
DATABASE_URL=postgresql+psycopg://content:content@db:5432/content_engine

# ===== برند =====
BRAND_NAME=کاراوان صنعت
BRAND_SITE_URL=https://caravansanat.com
BRAND_NICHE=کاراوان، کمپینگ، سفر با کاراوان و تجهیزات آن
BRAND_TONE=صمیمی، کاربردی و قابل‌اعتماد؛ محاوره‌ی مؤدبانه، بدون اغراق تبلیغاتی

LOG_LEVEL=INFO
