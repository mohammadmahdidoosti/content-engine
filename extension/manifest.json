{
  "manifest_version": 3,
  "name": "جمع‌آور کاروان صنعت",
  "version": "1.4.1",
  "description": "جمع‌آوری خودکار کانال‌های ایتا و تلگرام، قیمت ترب و آمار پنل ترب برای مدیر بازاریابی کاروان صنعت؛ با حساب‌های خود شما؛ بدون عضویت در کانال‌ها و فقط پیام‌هایی که خودتان در پنل تأیید کرده‌اید.",
  "permissions": ["storage", "alarms", "tabs", "scripting", "idle"],
  "host_permissions": [
    "https://content.caravansanat.com/*",
    "https://crawler.caravansanat.com/*",
    "https://web.eitaa.com/*",
    "https://web.telegram.org/*",
    "https://torob.com/*",
    "https://api.torob.com/*",
    "https://panel.torob.com/*",
    "https://www.google.com/*"
  ],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "جمع‌آور کاروان صنعت", "default_popup": "options.html"}
}
